{
  "policy_version": "1.0.0",
  "last_updated": "2026-09-07",
  "changed_by": "human_required",
  "_note": "This file is the machine-readable source of truth. config/policy.md is the human-readable mirror. Agents may read this file. Agents may NEVER write to it. Only a human edits it.",

  "chanty_pricing": {
    "price_per_seat_usd": 3.0,
    "currency": "USD",
    "billing_unit": "seat",
    "is_negotiable_by_agent": false,
    "approved_discounts": [],
    "approved_commission_terms": [],
    "approved_revenue_share_terms": [],
    "approved_exclusivity_terms": [],
    "approved_free_account_terms": [],
    "approved_extended_trial_terms": [],
    "statement": "Chanty is $3 per seat. The agent states this figure and nothing else about price."
  },

  "contact_data_policy": {
    "public_sources_only": true,
    "enrichment_allowed": false,
    "enrichment_requires_explicit_human_permission": true,
    "permission_scope": "per_contact",
    "email_guessing_allowed": false,
    "pattern_inference_allowed": false,
    "verification_of_guessed_addresses_allowed": false,
    "purchase_of_contact_data_allowed": false,
    "silent_fallback_allowed": false,
    "blocked_providers": [
      "apollo", "apollo.io", "zoominfo", "hunter", "hunter.io", "rocketreach",
      "lusha", "clearbit", "seamless.ai", "people data labs", "pdl", "snov.io",
      "findymail", "dropcontact", "prospeo", "anymailfinder", "voila norbert",
      "leadiq", "cognism", "uplead", "signalhire", "contactout", "wiza",
      "kaspr", "datagma", "skrapp", "getprospect", "clay contact enrichment"
    ],
    "blocked_tool_prefixes": [
      "mcp__Apollo_io__",
      "mcp__ZoomInfo__"
    ],
    "blocked_tool_names": [
      "mcp__Clay__find-and-enrich-contacts-at-company",
      "mcp__Clay__find-and-enrich-list-of-contacts",
      "mcp__Clay__add-contact-data-points"
    ],
    "permitted_public_sources": [
      "organization_website",
      "staff_page",
      "team_page",
      "leadership_page",
      "contact_page",
      "program_page",
      "event_page",
      "organization_published_pdf",
      "public_newsletter",
      "public_professional_profile",
      "public_social_profile_with_displayed_business_contact",
      "public_search_result_pointing_to_the_above",
      "general_organization_contact_form",
      "public_organization_phone"
    ],
    "email_status_values": [
      "public_verified",
      "not_publicly_found",
      "org_inbox_only",
      "form_only",
      "suppressed"
    ]
  },

  "clay_policy": {
    "allowed_for": [
      "organization_discovery",
      "organization_enrichment",
      "organization_research",
      "company_level_signals"
    ],
    "forbidden_for": [
      "contact_email_discovery",
      "contact_phone_discovery",
      "person_level_enrichment"
    ],
    "note": "Clay being connected is not permission to enrich contacts."
  },

  "max_touches": 4,
  "outreach_sequence": [
    {"touch": 1, "day": 0,  "purpose": "specific_opportunity"},
    {"touch": 2, "day": 4,  "purpose": "useful_context"},
    {"touch": 3, "day": 10, "purpose": "concrete_resource_or_example"},
    {"touch": 4, "day": 21, "purpose": "graceful_close"}
  ],
  "post_sequence_state": "NURTURE",
  "restart_requires_new_qualifying_signal": true,
  "min_days_between_touches": 3,
  "min_days_before_resequence": 90,

  "approved_offers": [
    "educational_workshop",
    "member_resource",
    "member_benefit",
    "partner_referral_program",
    "co_branded_content",
    "event_participation",
    "discovery_conversation"
  ],

  "human_escalation_triggers": [
    "national_partnership",
    "major_association",
    "franchise_organization",
    "major_msp_opportunity",
    "pricing_question",
    "commission_request",
    "referral_economics",
    "contract_request",
    "exclusivity_request",
    "data_sharing_request",
    "security_question",
    "compliance_question",
    "hipaa",
    "legal_issue",
    "media_request",
    "public_endorsement_request",
    "complaint",
    "unusual_request"
  ],

  "stop_automation_conditions": [
    "contact_replied",
    "contact_asked_question",
    "contact_showed_interest",
    "contact_asked_pricing",
    "contact_asked_partnership_economics",
    "contact_asked_meeting",
    "contact_asked_security",
    "contact_asked_compliance",
    "contact_complained",
    "contact_requested_no_further_contact"
  ],

  "autonomy": {
    "current_level": 0,
    "levels": {
      "0": "research only",
      "1": "research + scoring",
      "2": "research + contact discovery + drafts",
      "3": "automated outreach for approved Tier 2 organizations",
      "4": "expanded autonomous operation"
    },
    "default_posture": "DRAFT_DONT_SEND",
    "autonomous_send_enabled_categories": [],
    "tier_a_always_human_approved": true,
    "first_pilot_human_review_first_touch_count": 100
  },

  "agent_permissions": {
    "discovery":    {"may_write_states": ["DISCOVERED"], "may_send": false, "may_use_enrichment": false, "may_edit_policy": false},
    "intelligence": {"may_write_states": ["RESEARCHING", "QUALIFIED", "DISQUALIFIED", "NURTURE"], "may_send": false, "may_use_enrichment": false, "may_edit_policy": false},
    "opportunity":  {"may_write_states": [], "may_send": false, "may_use_enrichment": false, "may_edit_policy": false},
    "contact":      {"may_write_states": ["CONTACT_IDENTIFIED", "EMAIL_NOT_PUBLIC"], "may_send": false, "may_use_enrichment": false, "may_edit_policy": false},
    "signal":       {"may_write_states": [], "may_send": false, "may_use_enrichment": false, "may_edit_policy": false},
    "outreach":     {"may_write_states": ["READY_FOR_OUTREACH", "OUTREACH_ACTIVE"], "may_send": false, "may_use_enrichment": false, "may_edit_policy": false},
    "response":     {"may_write_states": ["RESPONSE_RECEIVED", "HUMAN_REVIEW", "SUPPRESSED", "NURTURE"], "may_send": false, "may_use_enrichment": false, "may_edit_policy": false},
    "learning":     {"may_write_states": [], "may_send": false, "may_use_enrichment": false, "may_edit_policy": false,
                     "may_recommend": ["targeting", "scoring_weights", "offer_prioritization", "sequencing", "research_depth", "lookalike_criteria"],
                     "may_not_modify": ["pricing", "suppression_rules", "compliance_rules", "approved_claims", "commercial_terms"]},
    "human":        {"may_write_states": ["*"], "may_send": true, "may_use_enrichment": true, "may_edit_policy": true}
  },

  "email_compliance": {
    "sender_identity_must_be_truthful": true,
    "subject_must_be_non_deceptive": true,
    "physical_address_required": true,
    "physical_address": null,
    "opt_out_required": true,
    "opt_out_link_token": "{{unsubscribe_url}}",
    "opt_out_processing_days_max": 10,
    "centralized_suppression_required": true,
    "sending_infrastructure": null,
    "legal_review_status": "not_reviewed",
    "note": "physical_address, sending_infrastructure and legal_review_status must be filled by a human before any send is permitted."
  },

  "gates": {
    "hard_qualification_gates": [
      "organization_verified",
      "audience_relevant",
      "distribution_mechanism_identified",
      "credible_contact_identified",
      "partnership_hypothesis_exists",
      "evidence_exists",
      "no_suppression",
      "no_material_contradiction"
    ],
    "send_gates": [
      "organization_verified",
      "contact_verified",
      "email_publicly_available",
      "evidence_verified",
      "suppression_clear",
      "recent_outreach_clear",
      "claims_approved",
      "commercial_language_clean",
      "offer_approved",
      "personalization_grounded",
      "escalation_clear",
      "compliance_configured",
      "autonomy_level_permits"
    ]
  },

  "scoring": {
    "max_score": 100,
    "bands": [
      {"name": "STRATEGIC", "min": 90, "max": 100},
      {"name": "TIER_1",    "min": 80, "max": 89},
      {"name": "TIER_2",    "min": 65, "max": 79},
      {"name": "NURTURE",   "min": 50, "max": 64},
      {"name": "ARCHIVE",   "min": 0,  "max": 49}
    ]
  },

  "signal_decay": [
    {"band": "very_strong", "min_days": 0,  "max_days": 14},
    {"band": "strong",      "min_days": 15, "max_days": 45},
    {"band": "moderate",    "min_days": 46, "max_days": 90},
    {"band": "historical",  "min_days": 91, "max_days": null}
  ],

  "partner_value_model_defaults": {
    "_note": "Assumptions until observed data replaces them. Learning Agent may propose changes; a human applies them.",
    "icp_fit": 0.35,
    "reach_rate": 0.15,
    "trial_rate": 0.03,
    "activation_rate": 0.4,
    "paid_conversion": 0.15,
    "average_seats": 8,
    "source": "assumption",
    "observations_count": 0
  }
}
