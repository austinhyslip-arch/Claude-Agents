  "email_compliance": {
    "sending_mode": "manual_gmail_draft",
    "_sending_mode_note": "Drafts are written into Austin's Gmail. He reads each one and sends it himself, one to one, from his own mailbox. Nothing is bulk sent and nothing sends itself. The requirements below are set for that mode. If the sending mode ever changes to a bulk platform, physical_address_required and opt_out_link_required go back to true and this needs another legal look.",
    "sender_identity_must_be_truthful": true,
    "subject_must_be_non_deceptive": true,
    "physical_address_required": false,
    "physical_address": null,
    "opt_out_link_required": false,
    "opt_out_link_token": null,
    "opt_out_honored_on_reply": true,
    "opt_out_processing_days_max": 1,
    "centralized_suppression_required": true,
    "sending_infrastructure": "gmail_draft_manual_send",
    "legal_review_status": "reviewed",
    "legal_review_note": "Austin confirmed 2026-09-08 that legal has reviewed the approach.",
    "legal_review_date": "2026-09-08"
  },
