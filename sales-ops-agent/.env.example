# Attio
ATTIO_API_KEY=your_attio_api_key_here
ATTIO_STAGE_SLUG=stage
ATTIO_LAST_CONTACTED_SLUG=last_contacted_at

# Anthropic (used to classify email conversations into stages)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail account this agent operates on
GMAIL_ACCOUNT=austin@chanty.com

# Google OAuth files (paths relative to project root)
GOOGLE_CREDENTIALS_PATH=config/google_credentials.json
GOOGLE_TOKEN_PATH=config/google_token.json

# How many hours back to scan email on each run
LOOKBACK_HOURS=24

# Timezone for scheduling follow-ups
TIMEZONE=America/Chicago
