  "email_format": {
    "plain_text_only": true,
    "html_body_allowed": false,
    "markdown_allowed": false,
    "sign_off_allowed": false,
    "_note": "Gmail supplies the signature and the formatting. The draft body is plain text, ends on the last real sentence, and carries no closer, no name, no title, no links block. Enforced by gates.check_format.",
    "banned_sign_offs": [
      "best",
      "best regards",
      "kind regards",
      "warm regards",
      "regards",
      "thanks",
      "thank you",
      "thanks again",
      "many thanks",
      "cheers",
      "sincerely",
      "yours",
      "talk soon",
      "speak soon",
      "looking forward",
      "all the best",
      "take care",
      "respectfully",
      "warmly"
    ]
  },
  "delivery_constraints": {
    "live_sessions_are_remote_only": true,
    "_note": "We join live sessions by video, not in person. That is a real constraint on what an organization is agreeing to, so it belongs in the first message rather than in the reply after they say yes. Enforced by gates.check_delivery_disclosure.",
    "offers_requiring_disclosure": [
      "educational_workshop",
      "event_participation"
    ],
    "disclosure_phrases": [
      "remotely",
      "by video",
      "over video",
      "virtually",
      "join by zoom",
      "not in person",
      "not in the room",
      "not be in the room",
      "join by video call"
    ],
    "travel_budget_exists": false
  },
  "send_window": {
    "_note": "Outreach lands inside the recipient's working day, in their local time, not ours. A message arriving at 5am reads as automated even when a person pressed send. Enforced by gates.check_send_window.",
    "start_hour_local": 8,
    "end_hour_local": 17,
    "weekdays_only": true,
    "weekdays": [
      0,
      1,
      2,
      3,
      4
    ],
    "narrow_hours_when_timezone_estimated": 1,
    "unknown_timezone_blocks_send": false,
    "unknown_timezone_fallback": {
      "enabled": true,
      "timezone": "America/Chicago",
      "start_hour_local": 12,
      "end_hour_local": 13,
      "_note": "When an organization's timezone cannot be resolved, send at noon Central. Noon Central is 10:00 Pacific, 11:00 Mountain and 13:00 Eastern, so it lands inside the working day in every US zone whichever one the organization turns out to be in.",
      "applies_to_non_us": true,
      "_non_us_caveat": "Noon Central is early evening in Europe. Discovery is US-only today so this does not bite, but set applies_to_non_us to false before working non-US organizations."
    }
  }
